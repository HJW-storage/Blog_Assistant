<Window x:Class="NaverBlogDraftAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="네이버 블로그 초안 도우미 (프로토타입)" Height="720" Width="1000">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- API 키 입력 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                <TextBlock Text="Groq API Key:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <PasswordBox x:Name="ApiKeyBox" Width="400" />
                <TextBlock Text="  console.groq.com 에서 무료 발급  ·  앱은 키를 저장하지 않습니다"
                           Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"/>
            </StackPanel>
            <TextBlock Foreground="#999999" FontSize="10" Margin="4,0,0,0"
                       Text="무료 한도 (llama-3.3-70b-versatile 기준): 분당 30회 요청  ·  일 14,400회 요청  ·  일 500,000 토큰"/>
        </StackPanel>

        <TabControl Grid.Row="1">

            <!-- 탭 1: 스타일 학습 -->
            <TabItem Header="1. 기존 글 스타일 학습">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 방법 A: URL로 자동 수집 -->
                    <GroupBox Grid.Row="0" Header="방법 1 — 블로그 URL로 자동 수집 (권장)" Margin="0,0,0,8" Padding="8">
                        <StackPanel>
                            <TextBlock Text="네이버 블로그 주소를 입력하세요 (예: https://blog.naver.com/myblogid)"
                                       Foreground="Gray" FontSize="11" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox x:Name="BlogUrlBox" Width="380" VerticalContentAlignment="Center"
                                         Text="https://blog.naver.com/" Margin="0,0,8,0"/>
                                <Button x:Name="FetchFromUrlButton" Content="URL에서 글 가져오기"
                                        Width="150" Click="FetchFromUrlButton_Click"/>
                            </StackPanel>
                            <ProgressBar x:Name="FetchProgressBar" Height="6" Minimum="0" Maximum="100"
                                         Value="0" Margin="0,0,0,4"/>
                            <TextBlock x:Name="FetchStatusLabel" Text="" Foreground="Gray" FontSize="11"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 방법 B: 파일 직접 선택 -->
                    <GroupBox Grid.Row="1" Header="방법 2 — .txt 파일 직접 선택" Margin="0,0,0,8" Padding="8">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LoadPostsButton" Content="기존 글(.txt) 파일 여러 개 선택..."
                                    Width="240" HorizontalAlignment="Left" Click="LoadPostsButton_Click"/>
                            <TextBlock x:Name="LoadedFilesLabel" Text="  선택된 파일: 0개"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 분석 버튼 -->
                    <Button x:Name="AnalyzeButton" Grid.Row="2" Content="스타일 분석하기" Width="150"
                            HorizontalAlignment="Left" Click="AnalyzeButton_Click" Margin="0,0,0,8"/>

                    <!-- 결과 -->
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="분석 결과 (프롬프트에 사용될 스타일 요약):" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="StyleSummaryBox" Height="200" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="AiAnalyzeButton" Content="AI 문체 심층 분석" Width="150"
                                    Click="AiAnalyzeButton_Click"/>
                            <TextBlock x:Name="AiAnalyzeStatusLabel" VerticalAlignment="Center"
                                       Foreground="Gray" FontSize="11" Margin="8,0,0,0"
                                       Text="  API 키 필요 · Groq 토큰 약 500개 소모"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 탭 2: 초안 생성 -->
            <TabItem Header="2. 초안 생성">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 제목 + 키워드 제안 버튼 -->
                    <TextBlock Text="제목" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,4"/>
                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleBox" Grid.Column="0" Margin="0,0,8,0"/>
                        <Button x:Name="SuggestKeywordsButton" Grid.Column="1"
                                Content="키워드 제안 받기" Width="130"
                                Click="SuggestKeywordsButton_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Margin="2,0,0,6" FontSize="11" Foreground="Gray" FontStyle="Italic"
                               Text="예시: 도쿄 타워 방문기 | 밤하늘을 수놓는 야경에 완전히 반해버렸어요 🗼"/>

                    <!-- AI 키워드 제안 결과 (버튼 클릭 전까지 숨김) -->
                    <Border x:Name="KeywordSuggestBorder" Grid.Row="3"
                            BorderBrush="#BBCCEE" BorderThickness="1"
                            Background="#F0F4FF" Margin="0,0,0,8" Padding="8"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="AI 키워드 제안" FontWeight="SemiBold"
                                       Foreground="#334488" Margin="0,0,0,4"/>
                            <TextBox x:Name="KeywordSuggestBox" Height="130" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- 개요 / 키워드 -->
                    <TextBlock Text="개요 / 키워드 (줄바꿈으로 여러 개 입력 가능)" FontWeight="Bold" Grid.Row="4" Margin="0,0,0,4"/>
                    <TextBox x:Name="OutlineBox" Grid.Row="5" Height="90" TextWrapping="Wrap"
                             AcceptsReturn="True" Margin="0,0,0,4"
                             VerticalScrollBarVisibility="Visible"/>
                    <TextBlock Grid.Row="6" Margin="2,0,0,10" FontSize="11" Foreground="Gray" FontStyle="Italic"
                               TextWrapping="Wrap">
                        예시: 도쿄 타워 입장료 및 예매 꿀팁 / 메인 덱(150m)과 탑 덱(250m) 차이 비교 / 야경 사진 잘 나오는 명당 / 주변 맛집 추천 (시바공원 근처) / 함께 들르면 좋은 인근 명소
                    </TextBlock>

                    <!-- 초안 생성 버튼 + 결과 -->
                    <Grid Grid.Row="7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="GenerateDraftButton" Content="초안 생성 (AI 호출)" Width="180"
                                HorizontalAlignment="Left" Click="GenerateDraftButton_Click" Margin="0,0,0,10"/>
                        <TextBox x:Name="DraftBox" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Visible"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 탭 3: 사진 자동 배치 (이미지 분석 기능 비활성화)
            <TabItem Header="3. 사진 자동 배치">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Button x:Name="AddImagesButton" Content="사진 추가..." Click="AddImagesButton_Click" Margin="0,0,0,10"/>
                        <ListBox x:Name="ImageListBox" Height="300" DisplayMemberPath="FileName"/>
                        <Button x:Name="RecommendPlacementButton" Content="배치 추천 받기 (AI 호출)"
                                Click="RecommendPlacementButton_Click" Margin="0,10,0,0"/>
                    </StackPanel>

                    <TextBox x:Name="PlacementResultBox" Grid.Column="1" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                </Grid>
            </TabItem>
            -->

            <!-- 탭 4: 네이버용 내보내기 -->
            <TabItem Header="4. 네이버로 내보내기">
                <StackPanel Margin="10">
                    <TextBlock TextWrapping="Wrap" Foreground="DarkRed" Margin="0,0,0,10">
                        ※ 네이버는 외부 프로그램이 직접 "임시저장"하도록 하는 공식 API를 제공하지 않습니다.
                        아래 버튼으로 완성된 초안을 클립보드에 복사한 뒤, 네이버 블로그 글쓰기 화면에
                        붙여넣고(Ctrl+V) 사용자가 직접 '임시저장'을 눌러주세요.
                    </TextBlock>

                    <Button x:Name="CopyToClipboardButton" Content="네이버용 서식으로 클립보드에 복사"
                            Width="260" HorizontalAlignment="Left" Click="CopyToClipboardButton_Click" Margin="0,0,0,10"/>

                    <Button x:Name="OpenNaverWriteButton" Content="네이버 블로그 글쓰기 페이지 열기"
                            Width="260" HorizontalAlignment="Left" Click="OpenNaverWriteButton_Click" Margin="0,0,0,10"/>

                    <Button x:Name="SaveHtmlButton" Content="HTML 파일로 저장 (백업용)"
                            Width="260" HorizontalAlignment="Left" Click="SaveHtmlButton_Click" Margin="0,0,0,10"/>

                    <TextBlock Text="생성된 HTML 미리보기 (그대로 클립보드에 복사됩니다):" FontWeight="Bold" Margin="0,10,0,4"/>
                    <TextBox x:Name="ExportPreviewBox" Height="300" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
